# PromptCEO Edit Studio — Render Worker Environment Variables
# Copy this file to workers/.env and fill in your values.
# The worker reads from process.env — use your platform's secret manager.

# ─── Required: Supabase ───────────────────────────────────────────────────────
# Same URL as your Next.js app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Service role key (NOT the anon key) — worker writes to DB and storage
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Render mode (controls Next.js API behavior) ──────────────────────────────
# inline  = attempt immediate FFmpeg render in the serverless function (local dev)
# queue   = always create a queued job (production / Vercel default)
EDIT_STUDIO_RENDER_MODE=queue

# ─── Worker identity ──────────────────────────────────────────────────────────
# Unique ID for this worker instance (used in job claiming + logs)
# Auto-generated if not set — set explicitly in multi-worker deployments
EDIT_RENDER_WORKER_ID=worker-prod-01

# ─── Worker tuning ────────────────────────────────────────────────────────────
# How often the worker polls for new jobs (milliseconds)
EDIT_RENDER_POLL_INTERVAL_MS=5000

# How long a processing job can run before being considered stale and re-queued (ms)
# Default: 10 minutes. Increase for very long renders.
EDIT_RENDER_STALE_TIMEOUT_MS=600000

# Per-render FFmpeg timeout (ms). Default: 5 minutes.
EDIT_RENDER_FFMPEG_TIMEOUT_MS=300000

# ─── Deployment notes ─────────────────────────────────────────────────────────
# The worker must have:
#   - Node.js 18+ on the host
#   - FFmpeg installed and accessible on PATH
#   - Network access to your Supabase project
#   - Read/write access to /tmp for working directories
#
# Recommended platforms:
#   Render.com   → Background Worker service, 0.5 CPU / 512 MB RAM is enough for short clips
#   Railway      → Worker service, add FFmpeg via Nixpacks or Dockerfile
#   Fly.io       → Dockerfile with FROM jrottenberg/ffmpeg as base
#   VPS / Docker → docker run with ffmpeg image + env vars
#
# PM2 (local or VPS):
#   npm install -g pm2
#   pm2 start workers/edit-render-worker.mjs --name edit-render-worker
#   pm2 save && pm2 startup
#
# Docker (example):
#   FROM jrottenberg/ffmpeg:4.4-ubuntu
#   RUN apt-get install -y nodejs npm
#   WORKDIR /app
#   COPY . .
#   RUN npm install @supabase/supabase-js
#   CMD ["node", "workers/edit-render-worker.mjs"]
